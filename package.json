{
  "name": "folio-markdown",
  "version": "1.0.0",
  "description": "Local-first visual Markdown desktop editor",
  "author": "Folio",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build:main && concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit && vite build --logLevel warn && npm run build:main",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "start": "electron .",
    "package:mac": "npm run build && node scripts/release-metadata.mjs && electron-builder --mac --arm64 --publish never",
    "package:win": "npm run build && node scripts/release-metadata.mjs && electron-builder --win --x64 --publish never",
    "package:linux": "npm run build && node scripts/release-metadata.mjs && electron-builder --linux --x64 --publish never --config.extraMetadata.homepage=file:///opt/Folio/resources/README.md"
  },
  "build": {
    "appId": "app.folio.markdown",
    "productName": "Folio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/mcp.*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Folio-${version}-windows-${arch}-Setup.${ext}"
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Folio",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "README.md",
          "to": "README.md"
        },
        {
          "from": "README.tr.md",
          "to": "README.tr.md"
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "asar": true,
    "artifactName": "Folio-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Folio-${version}-windows-${arch}-Portable.${ext}"
    },
    "extraResources": [
      {
        "from": "build/THIRD_PARTY_LICENSES.txt",
        "to": "THIRD_PARTY_LICENSES.txt"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "fflate": "0.8.3",
    "iconv-lite": "0.7.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/diff": "7.0.2",
    "@types/katex": "0.16.8",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.0",
    "codemirror": "6.0.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "katex": "0.19.1",
    "lowlight": "3.3.0",
    "lucide-react": "1.61.0",
    "mathlive": "0.111.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.0",
    "mermaid": "12.2.0",
    "node-diff3": "3.2.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-frontmatter": "5.0.0",
    "remark-math": "6.0.0",
    "remark-stringify": "11.0.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wait-on": "9.5.1"
  },
  "overrides": {
    "katex": "0.19.1"
  },
  "desktopName": "folio-markdown.desktop"
}
